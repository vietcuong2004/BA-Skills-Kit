{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metadata",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_type": {
      "enum": [
        "brainstorm",
        "requirements",
        "product-backlog",
        "round-plan",
        "business",
        "spec",
        "review",
        "workflow-state"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved"
      ]
    },
    "source_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "ba",
              "raw"
            ]
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "generated_by": {
      "enum": [
        "ba-brainstorm",
        "ba-requirements",
        "ba-product-backlog",
        "ba-round-plan",
        "ba-business",
        "ba-spec",
        "ba-review",
        "ba-workflow"
      ]
    },
    "pbi_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "epic_id": {
      "type": "string",
      "pattern": "^EPIC-[0-9]{3,}$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^FEAT-[0-9]{3,}$"
    },
    "round_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*[1-9][0-9]*$"
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-[0-9]{3,}$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "project_id",
    "status",
    "source_documents",
    "generated_by"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "document_type": {
            "enum": [
              "business",
              "spec",
              "review"
            ]
          }
        }
      },
      "then": {
        "required": [
          "pbi_id",
          "epic_id",
          "feature_id",
          "requirement_refs"
        ]
      }
    }
  ]
}
