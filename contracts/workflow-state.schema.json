{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow-state",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "INTERACTIVE",
        "DRAFT",
        "RESUME",
        "SINGLE-PBI",
        "SINGLE-ROUND"
      ]
    },
    "current_phase": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "ba",
              "raw"
            ]
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkpoint": {
            "enum": [
              "backlog",
              "round-plan",
              "publish"
            ]
          },
          "decision": {
            "enum": [
              "Approved",
              "Proposed Allowed",
              "Draft Publication"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decided_at": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "pbi_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "kind": {
                  "enum": [
                    "ba",
                    "raw"
                  ]
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "resolved_decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "checkpoint",
          "decision",
          "actor",
          "evidence",
          "decided_at",
          "pbi_refs",
          "documents",
          "resolved_decisions"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "last_updated": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "selected_pbis": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "selected_round": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "change": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "affected_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "at",
          "change",
          "affected_ids",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "mode",
    "current_phase",
    "completed",
    "pending",
    "blockers",
    "artifacts",
    "approvals",
    "last_updated",
    "selected_pbis",
    "change_history"
  ],
  "additionalProperties": false
}
