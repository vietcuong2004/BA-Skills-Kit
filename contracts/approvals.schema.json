{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "approvals",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkpoint": {
            "enum": [
              "backlog",
              "round-plan",
              "publish"
            ]
          },
          "decision": {
            "enum": [
              "Approved",
              "Proposed Allowed",
              "Draft Publication"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decided_at": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "pbi_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "kind": {
                  "enum": [
                    "ba",
                    "raw"
                  ]
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "resolved_decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "checkpoint",
          "decision",
          "actor",
          "evidence",
          "decided_at",
          "pbi_refs",
          "documents",
          "resolved_decisions"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "approvals"
  ],
  "additionalProperties": false
}
