{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "round-plan",
  "type": "object",
  "properties": {
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*[1-9][0-9]*$"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "Confirmed",
              "Proposed",
              "Open Question"
            ]
          },
          "pbi_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*[1-9][0-9]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "capacity_assumptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "confirmation_status": {
                  "enum": [
                    "Confirmed",
                    "Proposed",
                    "Open Question"
                  ]
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "text",
                "confirmation_status",
                "source_refs"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "capacity_gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "allocation_rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "approval_status": {
            "enum": [
              "Pending",
              "Approved",
              "Proposed Allowed"
            ]
          }
        },
        "required": [
          "round_id",
          "goal",
          "status",
          "pbi_refs",
          "dependencies",
          "risks",
          "capacity_assumptions",
          "capacity_gaps",
          "allocation_rationale",
          "approval_status"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "unassigned_pbis": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "change": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "affected_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "at",
          "change",
          "affected_ids",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "rounds",
    "unassigned_pbis",
    "change_history"
  ],
  "additionalProperties": false
}
